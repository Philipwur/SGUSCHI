# Optional grouped workspaces. Off by default; omitting JobSpecs is equivalent.
# To enable, list directories with their own complete inputs and OxParams.
# Quotes are optional; these folders can sit directly beside this OxParams.
# JobSpecs = [ZrC_low, ZrC_high, ZrN_low]
JobSpecs = []

#Simulation Setup Parameters
InitO2Count = 10 #Initial number of O2 molecules in the system.
GasRatio = 2 #Solid to gas ratio (along x axis)
Temperatures = [873, 973, 1073, 1273] #Temperatures to run the simulations at (in K).
NSims = 4 #Number of small cells to run per temperature.

# Optional oxygen-free bulk relaxation before creating any trajectories.
# One accepted geometry is reused for every temperature and replica in this spec.
# Relaxation = bulk
# See docs/bulk-relaxation.md for cutoff, k-mesh and walltime overrides.

#Simulation Runtime Parameters
AtomicRadiusTol = 1.50 #Tolerance for atomic radius comparison
O2Tol = 0.5            #Tolerance for O2 molecule detection
OSmoothing = 0.001     #Smoothing parameter for O2 count analysis

# MaxRuntime = 200   # Optional: stop after this many ps of simulated time.
#                    # If unset, runs until volsearch_cont detects convergence.
